<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="8dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <!-- Image du livre -->
    <ImageView
        android:id="@+id/imgLivre"
        android:layout_width="70dp"
        android:layout_height="90dp"
        android:layout_marginEnd="10dp"
        android:scaleType="centerCrop"
        android:background="#F2F2F2"
        android:contentDescription="Couverture du livre" />

    <!-- Texte (titre + prix + checkbox) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Titre du livre"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvPrix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prix: 100 DH"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginBottom="4dp" />

        <!-- ✅ maintenant clickable -->
        <CheckBox
            android:id="@+id/chkDispo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible"
            android:textColor="#333333" />
    </LinearLayout>
</LinearLayout>
